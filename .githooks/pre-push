#!/bin/sh
set -eu

remote_name=${1:-origin}
remote_url=${2:-}

if [ -z "$remote_url" ]; then
  remote_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
fi

case "$remote_url" in
  *github.com:tblt-gr/cadran | *github.com:tblt-gr/cadran.git | \
    *github.com/tblt-gr/cadran | *github.com/tblt-gr/cadran.git)
    ;;
  *)
    exit 0
    ;;
esac

blocked=''

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      blocked=main
      ;;
  esac
done

if [ -n "$blocked" ]; then
  printf '%s\n' "Direct push to '$blocked' is blocked: open a pull request instead." >&2
  exit 1
fi

exit 0
