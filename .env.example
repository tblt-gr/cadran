# Runtime configuration: make init copies this file to private .env.local once.
# Keep the project name: container, network and volume names are fixed to cadran_*.
COMPOSE_PROJECT_NAME=cadran
# Loopback only by default. Complete owner setup before exposing a trusted LAN/VPN address.
CADRAN_HTTPS_BIND=127.0.0.1
# Host HTTPS port; PostgreSQL is never published.
CADRAN_HTTPS_PORT=8443
# Host name used by Caddy and generated absolute URLs; must resolve on every client device.
CADRAN_SERVER_NAME=localhost
# Optional absolute backup directory: create it first with private permissions (0700).
# Only the unconfigured default ./backups is created automatically; no symlinks.
# CADRAN_BACKUP_DIR=/absolute/path/to/backups

# Generated, not configurable secrets: make init creates app_secret and db_password in
# var/docker-secrets/. Never put APP_SECRET, DATABASE_URL or passwords in this template.
# Keep those files with existing databases. Make derives CADRAN_VERSION from package.json;
# Compose derives DEFAULT_URI from the host/port and fixes APP_ENV=prod in the runtime.

# Command-only arguments: pass these to make, not as persistent .env.local settings.
# Backup: LABEL=manual|daily|pre-upgrade|pre-restore; DRY_RUN=1 previews retention.
# IDENTITY=/external/offline/identity.txt defaults only for backup-key to
# ~/.config/cadran/backup-identity.txt; verify/restore/upgrade/rollback require it explicitly.
# FILE=/absolute/path/cadran-YYYYMMDD-HHMMSS-manual.dump.age; CONFIRM=restore-cadran.
# Upgrade: VERSION=vX.Y.Z, optional FROM=vX.Y.Z when HEAD is not the installed release tag.
# Development: EMAIL selects a demo owner; PERF_ASSERT=1 enforces performance budgets.
# Browser tests: E2E_BASE_URL=https://localhost:8443, E2E_OWNER_EMAIL and E2E_OWNER_PASSWORD
# select the disposable owner only. HEADERS_PUBLIC_HOST=cadran.test tests public-host headers.
# Makefile internals (COMPOSE_ENV, image names, host UID/GID and result directories) are derived.
# Backup script overrides CADRAN_BACKUP_RECIPIENT_FILE, CADRAN_DB_PASSWORD_FILE and
# CADRAN_DB_NAME are reserved for tooling; normal installs use generated paths and cadran.
# CADRAN_BACKUP_NOW, CADRAN_BACKUP_ALLOW_TEST_CLOCK and CADRAN_RESTORE_LEAVE_APP_STOPPED
# are test/rollback internals; never enable these in normal installation configuration.
