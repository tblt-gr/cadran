{
  "name": "cadran",
  "version": "0.7.0",
  "private": true,
  "description": "Self-hosted personal budget and wealth tracking application",
  "license": "MIT",
  "author": "tblt-gr",
  "scripts": {
    "prepare": "sh ./scripts/install-git-hooks.sh || true",
    "format": "prettier --write . --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "deadcode": "knip",
    "lint:docs": "sh ./scripts/lint-docs.sh",
    "lint:infrastructure": "node scripts/test-infrastructure.mjs",
    "generate:api": "pnpm --filter @cadran/api-client generate",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm generate:api && pnpm --recursive --if-present test",
    "build": "pnpm generate:api && pnpm --recursive --if-present build",
    "lint:commands": "sh scripts/ci/check-documented-commands.sh && node scripts/ci/test-documented-commands.mjs",
    "quality": "pnpm lint:commands && pnpm generate:api && pnpm openapi:lint && pnpm openapi:csrf && pnpm format:check && pnpm lint && pnpm typecheck && pnpm deadcode",
    "openapi:lint": "redocly lint apps/api/openapi/openapi.yaml",
    "openapi:csrf": "node scripts/check-openapi-csrf.mjs apps/api/openapi/openapi.yaml",
    "e2e": "pnpm --filter @cadran/e2e e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@redocly/cli": "^2.49.0",
    "knip": "^6.41.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.9",
      "js-yaml": "4.3.2",
      "katex": "0.18.2",
      "markdown-it": "14.3.3",
      "smol-toml": "1.9.0",
      "source-map-js": "1.2.2",
      "undici": "7.30.1"
    }
  }
}
