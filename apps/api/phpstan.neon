includes:
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    shipmonkDeadCode:
        usageProviders:
            symfony:
                containerXmlPaths:
                    - var/cache/test/App_KernelTestDebugContainer.xml
    ignoreErrors:
        # Tests keep explicit assertions on values PHPStan already infers; they guard regressions of the contract.
        -
            identifier: staticMethod.alreadyNarrowedType
            path: tests
