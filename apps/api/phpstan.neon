includes:
    - vendor/shipmonk/dead-code-detector/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    shipmonkDeadCode:
        usageProviders:
            symfony:
                containerXmlPaths:
                    - var/cache/test/App_KernelTestDebugContainer.xml
    ignoreErrors:
        # Published reason values kept in the contract enum even though no producer emits them today.
        -
            message: '#^Unused App\\Module\\Budget\\Domain\\BudgetComparisonReason::MIXED_METRIC_POLICIES$#'
            identifier: shipmonk.deadEnumCase
            count: 1
            path: src/Module/Budget/Domain/BudgetComparisonReason.php
        # Kept so stored MonthlyProjectionReason values still decode (decision of the metric policy ticket RPT-006).
        -
            message: '#^Unused App\\Module\\Reporting\\Domain\\MonthlyProjectionReason::MISSING_BENEFIT_SOURCE$#'
            identifier: shipmonk.deadEnumCase
            count: 1
            path: src/Module/Reporting/Domain/MonthlyProjectionReason.php
