{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["lefthook"]
    },
    "apps/web": {
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
      "ignoreDependencies": ["@fontsource-variable/inter"]
    },
    "packages/api-client": {
      "entry": ["src/*.test.ts"],
      "project": ["src/**/*.ts", "!src/generated/**"]
    },
    "tests/e2e": {
      "entry": ["tests/*.setup.ts"],
      "project": ["**/*.ts"]
    }
  }
}
